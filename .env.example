# Copy to .env and fill in. Real environment variables override this file.

# OpenAI, used for bare model names ("gpt-4o")
OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1

# OpenRouter, used for namespaced model names ("anthropic/claude-sonnet-4.5")
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Optional attribution headers shown in OpenRouter rankings
# OPENROUTER_SITE_URL=https://t.me/nyannews
# OPENROUTER_APP_NAME=nyan

# Force a provider for every model name instead of inferring it: openai | openrouter
# LLM_PROVIDER=openrouter
